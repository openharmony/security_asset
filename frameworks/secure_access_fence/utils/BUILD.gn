import("//build/ohos.gni")

ohos_rust_static_library("saf_utils") {
  sources = [ "src/lib.rs", "src/json_builder.rs" ]
  
  deps = [
    "../definition:saf_definition",
    "../os_dependency/log:saf_log",
  ]

  external_deps = [ "ylong_json:lib" ]

rustflags = [ "-C", "codegen-units=1", "-C", "opt-level=z", "-C", "debuginfo=0" ]

sanitize = {
  integer_overflow = true
  cfi = true
  debug = false
  cfi_cross_dso = true
  boundary_sanitize = true
  ubsan = true
}

cflags_cc = [
  "-Wall",
  "-Werror",
  "-fPIC",
]

crate_name = "saf_utils"
  crate_type = "rlib"
  subsystem_name = "security"
  part_name = "asset"
}
