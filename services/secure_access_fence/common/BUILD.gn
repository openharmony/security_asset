import("//base/security/asset/config.gni")
import("//build/ohos.gni")
import("//build/test.gni")

ohos_rust_static_library("saf_common") {
  sources = [ "src/lib.rs" ]
  deps = [
    "../../../frameworks/secure_access_fence/os_dependency/log:saf_log",
    "../../../frameworks/secure_access_fence/definition:saf_definition",
    "../../../frameworks/secure_access_fence/utils:saf_utils",
    "../os_dependency:saf_os_dependency",
  ]
  external_deps = [
    "ipc:ipc_rust",
    "ylong_runtime:ylong_runtime",
    "ylong_json:lib",
  ]
  rustflags = [ "-C", "codegen-units=1", "-C", "opt-level=z", "-C", "debuginfo=0" ]
  if (enable_local_test) {
    rustflags += [ "--cfg", "feature=\"SAFTest\"" ]
    deps += [ "//third_party/rust/crates/lazy-static.rs:lib" ]
  }

  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }

  cflags_cc = [
    "-Wall",
    "-Werror",
    "-fPIC",
  ]

  crate_name = "saf_common"
  crate_type = "rlib"
  subsystem_name = "security"
  part_name = "asset"
}

