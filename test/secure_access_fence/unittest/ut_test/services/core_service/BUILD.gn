import("//base/security/asset/config.gni")
import("//build/ohos.gni")
import("//build/test.gni")

module_output_path = "asset/asset"

ohos_rust_unittest("rust_saf_core_service_ut_test") {
  module_out_path = module_output_path
  sources = [ "src/lib.rs" ]
  deps = [
    "../../../../../../services/secure_access_fence/core_service:secure_access_fence_service",
    "../../../../../../frameworks/secure_access_fence/definition:saf_definition",
    "../../../../../../services/secure_access_fence/common:saf_common",
    "../../../../../../frameworks/secure_access_fence/utils:saf_utils",
    "../../../../../../interfaces/inner_kits/plugin_interface/secure_access_fence:saf_plugin_interface_rust",
    "../../../../../../services/secure_access_fence/plugin:saf_plugin",
    "//third_party/rust/crates/lazy-static.rs:lib",
  ]
  rustflags = []
  if (enable_local_test) {
    rustflags += [ "--cfg", "feature=\"SAFTest\"" ]
  }
  external_deps = [
    "ipc:ipc_rust",
    "hilog:libhilog",
    "ylong_runtime:ylong_runtime",
  ]
  subsystem_name = "security"
  part_name = "asset"
}